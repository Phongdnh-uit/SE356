SMS_OTP_EXPIRATION=300
PHONE_VERIFIED_TOKEN_EXPIRATION=600
FORGOT_PASSWORD_CODE_EXPIRATION=300
PRECHALLENGE_TOKEN_EXPIRATION=600
MFA_CHALLENGE_EXPIRATION=600

