# JWT Configuration
JWT_SECRET_KEY=mySuperSecretKeyForJwtSigningMustBeLongEnoughToSatisfyHS256Requirements
JWT_EXPIRATION=86400000 # milliseconds (24 hours)
JWT_REFRESH_EXPIRATION=604800000 # milliseconds (7 days)

# Verification Configuration (in seconds)
